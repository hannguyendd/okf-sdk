# okf-web frontend dev server (`bun run dev`). Copy to `.env` (gitignored).

# Where the dev server proxies /api: the running `uv run okf-web` backend.
# `scripts/dev.sh --dev --web web` sets this (and PORT) for you.
# OKF_API=http://127.0.0.1:8765

# Port of the dev server itself (default 3000).
# PORT=3000
