# okf-backend configuration (also read by okf-mcp's `search`). Copy to `.env`
# (gitignored) and edit. Real paths and credentials belong in `.env`, never in
# this file.

# Where workspaces live: <OKF_HOME>/workspaces/<name>. Defaults to ~/.okf.
# OKF_HOME=/path/to/okf-home

# Semantic search: an OpenAI-compatible embeddings server, base URL including
# any /v1 prefix. Leave unset to disable search.
# OKF_EMBEDDING_URL=http://localhost:1234/v1
# OKF_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# OKF_EMBEDDING_API_KEY=
