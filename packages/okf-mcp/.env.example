# okf-mcp configuration. Copy to `.env` (gitignored) and edit.
# Real paths and credentials belong in `.env`, never in this file.

# Where workspaces live: <OKF_HOME>/workspaces/<name>. Defaults to ~/.okf.
# OKF_HOME=/path/to/okf-home

# Default target. Tool args and X-OKF-Workspace / X-OKF-Bundle headers override
# these; when unset, the session's earlier pick, the only candidate, or the user
# (elicitation) decides.
OKF_WORKSPACE=team
OKF_BUNDLE=notes

# Semantic search (`search` tool): an OpenAI-compatible embeddings server,
# base URL including any /v1 prefix. Leave unset to disable search.
# OKF_EMBEDDING_URL=http://localhost:1234/v1
# OKF_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# OKF_EMBEDDING_API_KEY=
