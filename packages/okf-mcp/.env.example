# okf-mcp configuration. Copy to `.env` (gitignored) and edit.
# Real paths and credentials belong in `.env`, never in this file.
#
# Each root is a location: a local path, a file:// URI, or a scheme:// URI
# for a storage backend registered with okf_core (see okf_core.Storage).
# A plain path uses the local filesystem, which is the default.

# Single-bundle mode: the one bundle the server edits.
# A per-call `bundle_root` tool argument overrides it.
OKF_BUNDLE_ROOT=/path/to/bundle

# Store mode: a base location. The server keeps one bundle per project in
# <store>/<project-basename>-<hash8>, taking the project path from the client's
# MCP roots (falling back to the working directory). The store must already exist.
# Set this OR OKF_BUNDLE_ROOT, not both. Setting both is an error.
# OKF_STORE_ROOT=/path/to/store