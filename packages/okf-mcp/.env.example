# okf-mcp configuration. Copy to `.env` (gitignored) and edit.
# Real paths and credentials belong in `.env`, never in this file.
#
# `.env` is read from the directory the server starts in. The workspace is not
# configured here: pass `--workspace <name>` (stdio) or send the
# X-OKF-Workspace header (streamable-http).

# OKF_HOME is NOT read from `.env`: export it in the shell, or pass it as an
# environment variable in the MCP client's server config.
# Workspaces live in <OKF_HOME>/workspaces/<name>; the default home is ~/.okf.
#   export OKF_HOME=/path/to/okf-home

# Semantic search (`search` tool; implemented and configured by okf-backend):
# an OpenAI-compatible embeddings server, base URL including any /v1 prefix.
# Leave URL and MODEL unset to disable search.
# OKF_EMBEDDING_URL=http://localhost:1234/v1
# OKF_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# OKF_EMBEDDING_API_KEY=

# Characters of each `_index.md` sent to the embedding model (default 6000).
# Match it to the model's context window: text past the window is silently
# ignored. mxbai-embed-large-v1 (512 tokens) reads about 2000 characters;
# nomic-embed-text-v1.5 handles the default.
# OKF_EMBEDDING_MAX_CHARS=2000
